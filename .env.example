# Database configuration (centralized).
# Default deployment uses an external PostgreSQL database such as Supabase.
# Provide the actual DATABASE_URL through local .env or deployment secrets.
# Do not commit real credentials.
#
# Supabase connection guidance:
# - Prefer Session Pooler for Render/external IPv4 deployments when direct
#   connectivity is incompatible.
# - Direct connection is fine when network/IPv6 compatibility is confirmed.
# - Do not assume Transaction Pooler. If you intentionally use it, set
#   DB_DISABLE_PREPARED_STATEMENTS=1 and keep pool sizes small/use NullPool.
#
# Example formats (placeholders only):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require  # transaction pooler (special settings required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Optional SQLAlchemy/Supabase engine tuning.
# DB_POOL_PRE_PING=1
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_SSLMODE=require  # only needed if not present in DATABASE_URL
# DB_DISABLE_PREPARED_STATEMENTS=0  # set 1 for transaction pooler/PgBouncer tx mode

# Local development only (docker-compose.local-db.yml).
# These are not used by the default external/Supabase compose file.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=fnw_task_logger

# AI provider selected by the application. Cohere is implemented today; the
# MCP layer is provider-independent so OpenAI can be added later.
AI_PROVIDER=cohere

# Cohere (required when AI_PROVIDER=cohere)
COHERE_API_KEY=your_cohere_api_key_here

# MCP server and client. The server is mounted by the backend at /mcp by
# default and uses the official MCP Streamable HTTP transport.
MCP_ENABLED=true
MCP_TRANSPORT=streamable-http
MCP_SERVER_NAME=fnw-task-manager
MCP_PATH=/mcp
# Require a bearer access token for every MCP request. Keep true.
MCP_REQUIRE_AUTH=true
# The local URL used by the Cohere adapter. In Docker the backend listens on
# port 8000 internally; for host-only development use the same value.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp/
MCP_STATELESS=true
MCP_JSON_RESPONSE=true
MCP_TOOL_CACHE_SECONDS=300
MCP_MAX_BODY_SIZE=4194304
MCP_SESSION_IDLE_TIMEOUT=900
# Enable DNS-rebinding protection behind a known proxy/host list.
MCP_DNS_REBINDING_PROTECTION=false
# MCP_ALLOWED_HOSTS=tasks.example.com,backend:8000
# MCP_ALLOWED_ORIGINS=https://tasks.example.com

# Published ports (host side)
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Browsers allowed to call the API cross-origin. Requests through the
# bundled frontend are same-origin and do not need to be listed.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# LLM-controlled database agent with native tool calling. When enabled, a
# fresh chat turn is handled by the agent (inspect schema, generate SQL,
# execute, observe, repair, answer). The deterministic flow is the fallback.
DATABASE_AGENT=1

# Optional bounds for the agent loop.
# DATABASE_AGENT_MAX_STEPS=6
# DATABASE_AGENT_MAX_ROWS=200
# DATABASE_AGENT_SQL_TIMEOUT_MS=5000

# Schema-aware read planner: after a zero-row list result the agent can
# inspect the observation and plan a corrected query.
AGENTIC_READ=1

# Progressive task creation. These fields must be present before a new task
# can be saved; the rest are optional and use sensible defaults.
TASK_REQUIRED_FIELDS=task_title,task_description,assigned_to,deadline_date,deadline_time

# Timezone and speech-to-text model
TZ=Asia/Kolkata
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Google OpenID Connect authentication and database-backed RBAC.
# AUTH_REQUIRED=0 is only for local test runs; production must keep it enabled.
AUTH_REQUIRED=1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_a_long_random_value

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Must match the authorized redirect URI in Google Cloud Console.
# FastAPI backend exposes /auth/google/callback directly on BACKEND_PORT.
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback
# Comma-separated allowed frontend origins (Vite dev + Docker bundled).
FRONTEND_URL=http://localhost:8088,http://localhost:5173
# Default post-login redirect; must be within FRONTEND_URL origins.
AUTH_POST_LOGIN_REDIRECT=http://localhost:8088
# Optional endpoint overrides (defaults shown).
# GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# Optional: restrict sign-in to one verified work-email domain.
# AUTH_ALLOWED_EMAIL_DOMAIN=example.com
# First administrator for a new deployment. Run:
# docker compose exec backend python -m auth.bootstrap --email you@example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
# Access tokens are short-lived; refresh tokens rotate on every refresh.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Use true behind HTTPS. Keep false only for local HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Optional cookie domain, e.g. .example.com for a shared parent domain.
# AUTH_COOKIE_DOMAIN=

# Reminder notifications and Web Push.
# Generate VAPID keys once, then keep the private key server-side only:
#   python scripts/generate_vapid_keys.py
# VAPID_PRIVATE_KEY may be the base64 value, or set VAPID_PRIVATE_KEY_PATH to
# a mounted file containing it. If both are empty, push is disabled but the
# in-app notification center and reminder worker still run.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=
VAPID_SUBJECT=mailto:something@example.com
# Reminder worker. Keep these values identical when running more than one.
REMINDER_POLL_SECONDS=20
REMINDER_BATCH_SIZE=100
REMINDER_MAX_RETRIES=5
REMINDER_RETRY_BASE_SECONDS=30
REMINDER_RETRY_MAX_SECONDS=3600
REMINDER_MAX_AGE_HOURS=168
REMINDER_PROCESSING_TIMEOUT_SECONDS=300

# MCP client credentials (for external MCP clients such as OpenClaw).
# Issued via authenticated API: POST /auth/mcp-credentials (plaintext shown once).
# Store only in the client/operator secret store; never commit real credentials.
# Configure OpenClaw with Authorization: Bearer fnw_mcp_<credential> to /mcp/.
# Cohere's local MCP URL and browser JWT/session auth remain unchanged.

# tunnel-client (ChatGPT connector): inject dedicated MCP credential upstream.
# Keep the plaintext credential in a protected env var or file on the tunnel host.
# Example profile fields (supported):
#   mcp:
#     extra_headers:
#       Authorization: "Bearer env:FNW_MCP_CREDENTIAL"
#     discovery_extra_headers:
#       Authorization: "Bearer env:FNW_MCP_CREDENTIAL"
#     server_urls:
#       - channel: main
#         url: "http://127.0.0.1:8000/mcp/"
# Do not store plaintext credentials in git, logs, or source.

# OpenAI tunnel-client (Docker Compose mcp-tunnel service).
# Optional for Compose management commands (config/down/ps), but required to
# actually start mcp-tunnel. The mcp-tunnel container exits with a clear error
# when this is missing/empty; it never starts unauthenticated.
# CONTROL_PLANE_API_KEY authenticates tunnel-client to OpenAI control plane only.
# Do not commit the real value.
# CONTROL_PLANE_API_KEY=

# Optional overrides for mcp-tunnel.
# TUNNEL_CLIENT_BIN=tunnel/bin/tunnel-client
# TUNNEL_PROFILE_PATH=./tunnel/config/fnw-chatgpt.compose.yaml
# TUNNEL_PROFILE_FILE=/etc/tunnel/fnw-chatgpt.yaml
# FNW_MCP_AUTHORIZATION_FILE=./tunnel/secrets/fnw-mcp-authorization
# The authorization file must contain the full line/value:
#   Bearer fnw_mcp_<dedicated-credential>
# It is mounted read-only into mcp-tunnel and injected upstream as FnW MCP auth.

# MCP bootstrap credential reconciliation (safe, idempotent).
# The backend reads this at startup AFTER migrations and BEFORE serving MCP.
# It registers the credential hash for MCP_BOOTSTRAP_EMPLOYEE_ID only if missing.
# It NEVER reactivates/recreates revoked or expired credentials and NEVER
# reassigns a hash to a different employee.
MCP_BOOTSTRAP_EMPLOYEE_ID=1
# Preferred: read-only mounted file containing "Bearer fnw_mcp_..." or raw token.
# MCP_BOOTSTRAP_CREDENTIAL_FILE=/run/secrets/fnw-mcp-authorization
# Fallback env var (avoid in committed files); file is preferred.
# MCP_BOOTSTRAP_CREDENTIAL=
